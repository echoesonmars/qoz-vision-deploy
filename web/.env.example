# Postgres. Supabase IPv4: Shared / Session pooler (Dashboard → Connect → Connection string)
# Пример: postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Подпись сессии (JWT), минимум 32 символа. Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Supabase (incidents + lesson_analyses, бакет Storage = records)
# Миграция уроков: node scripts/migrate-lesson-analyses.mjs
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co

# Dashboard → API Keys → publishable (или legacy anon). Загрузка видео из браузера в Storage (без Node S3 / SSL).
# После первой настройки: SQL Editor → scripts/supabase-storage-rls.sql
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Опционально: service role для серверной загрузки REST
SUPABASE_SERVICE_ROLE_KEY=

# S3-совместимый доступ (Dashboard → Storage → S3) — для signed URL / бэкенд; загрузку можно STORAGE_UPLOAD_BACKEND=s3
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_ENDPOINT=https://YOUR_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1

# supabase (по умолчанию, если задан SERVICE_ROLE) | s3 — принудительный драйвер загрузки
# STORAGE_UPLOAD_BACKEND=supabase

# Макс. размер видео при загрузке (МБ). Supabase Pro: до ~5120 (5 ГБ) на объект в Storage.
# UI + проверка на клиенте; next.config — bodySizeLimit. Загрузка идёт через API Next (см. чеклист: для 5 ГБ лучше presigned в Storage).
VIDEO_MAX_UPLOAD_MB=5120
NEXT_PUBLIC_VIDEO_MAX_UPLOAD_MB=5120

# Qoz backend (Railway): analyze + live monitor + fleet
BACKEND_URL=http://localhost:8080
BACKEND_INTERNAL_SECRET=
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Базовый URL HLS: NVR и IPC325/IPC2123 — equipmentId+канал; DH-IPC — id камеры + sub 1
NEXT_PUBLIC_CAMERA_HLS_BASE=https://v-guard.kz/hls

# Макс. одновременных HLS-превью в сетке (inView + слот)
NEXT_PUBLIC_HLS_PREVIEW_MAX=4

